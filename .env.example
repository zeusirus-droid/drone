# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Target recipient email address for contact form submissions
CONTACT_EMAIL=admin@thebelmarmarketing.com

# Optional SMTP Configuration for direct email dispatch (e.g. SendGrid, Mailgun, Gmail, Custom SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Resend API key for transactional email sending
RESEND_API_KEY=
